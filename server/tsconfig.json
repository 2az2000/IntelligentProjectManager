{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "rootDir": ".",
    "outDir": "./dist",
    "noUncheckedIndexedAccess": true,
    "sourceMap": true
  },
  "include": ["src/**/*", "prisma/**/*", "tests/**/*", "vitest.config.mts", "prisma.config.ts"],
  "exclude": ["node_modules", "dist"]
}
