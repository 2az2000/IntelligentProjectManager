// Prisma schema — see server/docs/ARCHITECTURE.md §7 for the target data model.
// Change it only through `prisma migrate dev` (never edit an applied migration).

generator client {
  provider = "prisma-client-js"
}

/// §3: official Iranian holidays — `work-calendar.ts` skips them when rolling dates forward.
model Holiday {
  /// Calendar day at 00:00 local time.
  date        DateTime
  title       String
  /// Annual occurrences (e.g. Persian New Year fixed days) vs lunar-shift ones (yearly import).
  isRecurring Boolean

  @@id([date])
  @@index([date])
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  passwordHash String
  name         String
  avatarUrl    String?
  locale       String  @default("fa")
  theme        String?
  /// Phase 5: daily digest + due-date reminder emails (nodemailer in dev logs to console).
  notifyEmail  Boolean @default(true)

  memberships         ProjectMember[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  ownedProjects       Project[]            @relation("ProjectOwner")
  authoredTasks       Task[]               @relation("TaskAuthor")
  assignedTasks       Task[]               @relation("TaskAssignee")
  collaboratingTasks  TaskCollaborator[]
  comments            Comment[]
  timeEntries         TimeEntry[]
  attachments         Attachment[]         @relation("AttachmentUploader")
  taskActivities      ActivityLog[]        @relation("ActivityActor")
  notifications       Notification[]       @relation("NotificationOwner")
  actedNotifications  Notification[]       @relation("NotificationActor")
  commentReactions    CommentReaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// §11: one-time password reset tokens (hashed; 1h expiry; reuse revokes the family of recent tokens).
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    Int
  /// All tokens created by rotating one login session share a family (reuse detection).
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Project {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?

  ownerId Int
  owner   User @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  members      ProjectMember[]
  tasks        Task[]
  /// Structured label vocabulary of this project (colour + icon); task tags match labels by name.
  labels       Label[]
  /// Workflow columns of this project, in order; tasks point at one by `statusKey`.
  statuses     ProjectStatus[]
  /// §6: billing-rate default for all members without an override (used by cost reports).
  hourlyRate   Decimal?        @db.Decimal(14, 2)
  /// §6: total approved budget in currency units — progress bar vs booked cost.
  budgetAmount Decimal?        @db.Decimal(14, 2)

  archivedAt DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([ownerId])
}

model ProjectMember {
  projectId            Int
  userId               Int
  role                 ProjectRole @default(MEMBER)
  /// Free-text specialties (e.g. frontend, backend, marketing) — used by AI task enrichment.
  skills               String[]    @default([])
  /// §3: per-member weekly capacity in working hours (null = server default) — drives workload & leveling.
  capacityHoursPerWeek Int?
  /// §6: personal hourly rate override for project cost reports (null = project default).
  hourlyRate           Decimal?    @db.Decimal(14, 2)
  /// §6: per-member budget for project cost reports (null = project fallback).
  budgetAmount         Decimal?    @db.Decimal(14, 2)
  /// §6: tracked time entries (start/stop timer + manual entry) — powers cost & burn reports.
  timeEntries          TimeEntry[]

  joinedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

/// Project-scoped workflow column. `key` is what a task stores; the four built-ins
/// (TODO/IN_PROGRESS/REVIEW/DONE) are translated client-side, custom keys show `label`.
model ProjectStatus {
  id        Int        @id @default(autoincrement())
  projectId Int
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// ASCII slug stored on tasks; unique inside the project.
  key       String
  /// Fallback display name for statuses the client has no translation for.
  label     String
  /// `#rrggbb` — validated by the API so the UI can render it directly.
  color     String     @default("#64748b")
  /// Which analytics bucket this column counts as (drives doneness & progress charts).
  category  TaskStatus @default(TODO)
  /// Column order inside the board — fractional, like Task.position.
  position  Float      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, key])
  @@index([projectId, position])
}

model Task {
  id            Int          @id @default(autoincrement())
  title         String
  description   String?
  /// Analytics bucket of `statusKey` (kept in sync by the service): TODO | IN_PROGRESS | REVIEW | DONE.
  status        TaskStatus   @default(TODO)
  /// The project's workflow column this task sits in (a ProjectStatus.key of the same project).
  statusKey     String       @default("TODO")
  priority      TaskPriority @default(MEDIUM)
  /// Ordering inside a status column (fractional indexing — see modules/tasks/domain/position.ts).
  position      Float        @default(0)
  tags          String[]     @default([])
  startDate     DateTime?
  dueDate       DateTime?
  completedAt   DateTime?
  points        Int?
  /// Effort estimate in working hours — drives CPM durations (see modules/scheduling).
  estimateHours Float?

  parentId Int?
  parent   Task?  @relation("SubTasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[] @relation("SubTasks")

  /// Rows where this task is the predecessor (it blocks these tasks).
  blocks    TaskDependency[] @relation("TaskDependencyPredecessor")
  /// Rows where this task is the successor (it depends on these tasks).
  dependsOn TaskDependency[] @relation("TaskDependencySuccessor")

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId Int
  author   User @relation("TaskAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  assigneeId Int?
  assignee   User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Co-assignees: everyone who shares the task besides the lead above.
  collaborators TaskCollaborator[]

  attachments   Attachment[]
  timeEntries   TimeEntry[]
  comments      Comment[]
  activities    ActivityLog[]
  notifications Notification[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([projectId, status, position])
  @@index([assigneeId])
  @@index([parentId])
  @@index([dueDate])
}

///
/// Several people on one task: the lead stays in `Task.assigneeId` (so workload reports and
/// due-date reminders keep their meaning) and everyone else shares the task through a row here.
/// Both groups are notified and both see the task in "my tasks"; `Task.assigneeId = null`
/// means the task has no owner at all.
///
/// Rows are ordered by `id` so the assignee list has a stable order across requests.
model TaskCollaborator {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([userId])
}

/// Finish-to-start: the predecessor must finish before the successor can start.
enum DependencyType {
  FINISH_TO_START
}

///
/// A project's own label vocabulary: the structured half of a task's free-text `tags`.
///
/// `Task.tags` still holds plain strings so filtering, exports and the AI tag pool keep working;
/// a label adds the presentation the user asked for — a colour and an icon — plus one place to
/// manage the names a project actually uses. Task tags match labels by exact name.
model Label {
  id        Int      @id @default(autoincrement())
  name      String
  /// `#rrggbb` — validated by the API so the UI can render it directly.
  color     String
  /// Key from the shared icon set (client/src/features/labels/lib/label-icons.ts).
  icon      String
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One label per name per project — the vocabulary has no duplicates.
  @@unique([projectId, name])
  @@index([projectId])
}

/// §6: actual effort tracked against a task (timer start/stop or manual minutes).
model TimeEntry {
  id        Int       @id @default(autoincrement())
  taskId    Int
  userId    Int
  startedAt DateTime
  endedAt   DateTime?
  /// Minutes counted so far (open entries keep counting from startedAt).
  minutes   Int
  /// True when the user forgot stopwatch mode: filled manually with the real amount.
  manual    Boolean   @default(false)

  task                   Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectMember          ProjectMember? @relation(fields: [projectMemberProjectId, projectMemberUserId], references: [projectId, userId])
  projectMemberProjectId Int?
  projectMemberUserId    Int?

  /// The "single open timer" rule: two simultaneous open entries for one user are impossible.
  @@unique([userId, endedAt])
  @@index([taskId])
}

model TaskDependency {
  predecessorId Int
  successorId   Int
  type          DependencyType @default(FINISH_TO_START)

  predecessor Task @relation("TaskDependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   Task @relation("TaskDependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@id([predecessorId, successorId])
  @@index([successorId])
}

/// Phase 4: file attached to a task (disk-local storage in dev — storageKey is the relative path).
model Attachment {
  id         Int      @id @default(autoincrement())
  taskId     Int
  uploaderId Int
  fileName   String
  mimeType   String
  /// Bytes on disk.
  size       Int
  storageKey String
  createdAt  DateTime @default(now())

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader User @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

/// Phase 5: audit trail of task changes, rendered as the drawer timeline.
model ActivityLog {
  id        Int      @id @default(autoincrement())
  taskId    Int
  actorId   Int
  /// created | updated | moved | deleted | commented
  action    String
  /// Field that changed (status, assigneeId, dueDate, ...); null for created/deleted.
  field     String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

/// Phase 5: in-app notifications (assignment, comment, mention, due reminder).
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  /// ASSIGNED | COMMENTED | MENTIONED | DUE_REMINDER | DAILY_DIGEST
  type      String
  actorId   Int?
  taskId    Int?
  projectId Int?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user  User  @relation("NotificationOwner", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  task  Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Comment {
  id       Int    @id @default(autoincrement())
  body     String
  taskId   Int
  authorId Int

  task      Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions CommentReaction[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([taskId, createdAt])
}

///
/// §Imp §5: a one-tap answer to a comment. Emoji are a closed set validated by the API, and the
/// composite key makes "the same person reacted twice with the same emoji" impossible — reacting
/// is a toggle, not a counter that can drift.
model CommentReaction {
  id        Int      @id @default(autoincrement())
  commentId Int
  userId    Int
  /// One emoji from ALLOWED_REACTIONS (server-side allowlist).
  emoji     String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId, emoji])
  @@index([commentId])
}
