// Prisma schema — see server/docs/ARCHITECTURE.md §7 for the target data model.
// Change it only through `prisma migrate dev` (never edit an applied migration).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  passwordHash String
  name         String
  avatarUrl    String?
  locale       String  @default("fa")
  theme        String?

  memberships     ProjectMember[]
  refreshTokens   RefreshToken[]
  ownedProjects   Project[]       @relation("ProjectOwner")
  authoredTasks   Task[]          @relation("TaskAuthor")
  assignedTasks   Task[]          @relation("TaskAssignee")
  comments        Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    Int
  /// All tokens created by rotating one login session share a family (reuse detection).
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Project {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?

  ownerId Int
  owner   User @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  members ProjectMember[]
  tasks   Task[]

  archivedAt DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([ownerId])
}

model ProjectMember {
  projectId Int
  userId    Int
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Task {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  /// Ordering inside a status column (fractional indexing — see modules/tasks/domain/position.ts).
  position    Float        @default(0)
  tags        String[]     @default([])
  startDate   DateTime?
  dueDate     DateTime?
  completedAt  DateTime?
  points       Int?
  /// Effort estimate in working hours — drives CPM durations (see modules/scheduling).
  estimateHours Float?

  parentId Int?
  parent   Task?  @relation("SubTasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[] @relation("SubTasks")

  /// Rows where this task is the predecessor (it blocks these tasks).
  blocks    TaskDependency[] @relation("TaskDependencyPredecessor")
  /// Rows where this task is the successor (it depends on these tasks).
  dependsOn TaskDependency[] @relation("TaskDependencySuccessor")

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId Int
  author   User @relation("TaskAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  assigneeId Int?
  assignee   User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  attachments Attachment[]
  comments    Comment[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([projectId, status, position])
  @@index([assigneeId])
  @@index([parentId])
  @@index([dueDate])
}

/// Finish-to-start: the predecessor must finish before the successor can start.
enum DependencyType {
  FINISH_TO_START
}

/// Dependency edge between two top-level tasks of the same project.
model TaskDependency {
  predecessorId Int
  successorId   Int
  type          DependencyType @default(FINISH_TO_START)

  predecessor Task @relation("TaskDependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   Task @relation("TaskDependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@id([predecessorId, successorId])
  @@index([successorId])
}

model Attachment {
  id           Int     @id @default(autoincrement())
  fileURL      String
  fileName     String?
  taskId       Int
  uploadedById Int

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Comment {
  id       Int    @id @default(autoincrement())
  body     String
  taskId   Int
  authorId Int

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([taskId, createdAt])
}
