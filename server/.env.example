NODE_ENV=development
PORT=8000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/projectmanagement?schema=public"
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# At least 32 random characters each — generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Phase 6: global per-IP request budget (auth endpoints have their own tighter limiter).
RATE_LIMIT_PER_MINUTE=300

# Phase 4: attachment storage (disk-local; MinIO can replace it later).
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
# Phase 4: working-day calendar — weekend days for scheduling (Iran default Thu/Fri).
WORKING_WEEKEND=THURSDAY,FRIDAY
# Phase 5: BullMQ background jobs (due reminders, daily digest). Unreachable Redis only warns.
REDIS_URL=redis://localhost:6379
JOBS_ENABLED=true

# Phase 7: AI features (task enrichment, project docs) through any OpenAI-compatible API.
# Recommended free option: OpenRouter https://openrouter.ai — works from Iran, strong free models.
#   AI_MODEL examples: deepseek/deepseek-v3.2-exp:free  (recommended: strong + JSON)
#                      meta-llama/llama-3.3-70b-instruct:free
#   Key: openrouter.ai/keys → create → paste below.
# Other options:
#   Google AI Studio https://aistudio.google.com — AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai , AI_MODEL=gemini-2.5-flash
#   Groq https://console.groq.com — blocked for Iranian IPs at the time of writing
# Leave AI_API_KEY empty to disable the /ai endpoints (they answer 503 AI_NOT_CONFIGURED).
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=deepseek/deepseek-v3.2-exp:free
AI_TIMEOUT_MS=60000
