NODE_ENV=development
PORT=8000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/projectmanagement?schema=public"
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# At least 32 random characters each — generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Phase 6: global per-IP request budget (auth endpoints have their own tighter limiter).
RATE_LIMIT_PER_MINUTE=300

# Phase 4: attachment storage (disk-local; MinIO can replace it later).
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
# Phase 4: working-day calendar — weekend days for scheduling (Iran default Thu/Fri).
WORKING_WEEKEND=THURSDAY,FRIDAY
# §2.10: IANA zone used for calendar days (digest "today", overdue days) and for the 08:00
# digest / Monday weekly cron. The app itself runs in UTC inside Docker; without this, "today"
# started at 03:30 Tehran and the 08:00 digest was delivered at 11:30.
APP_TIME_ZONE=Asia/Tehran
# Phase 5: BullMQ background jobs (due reminders, daily digest). Unreachable Redis only warns.
REDIS_URL=redis://localhost:6379
JOBS_ENABLED=true

# §2.1: real email delivery (password reset, due reminder, digest, weekly report).
# Leave SMTP_URL empty to keep the json transport: mails are logged, never sent — which is what
# development and tests want. Set a full connection URL to deliver, e.g.
#   SMTP_URL=smtps://user:password@smtp.example.com:465
#   SMTP_URL=smtp://user:password@smtp.example.com:587
# MAIL_ENABLED=false disables delivery entirely (tokens are still created).
SMTP_URL=
MAIL_FROM="ManageSys <noreply@managesys.local>"
MAIL_ENABLED=true

# Phase 7: AI features (task enrichment, project docs) through any OpenAI-compatible API.
# Recommended free option: OpenRouter https://openrouter.ai — works from Iran, strong free models.
#   Key: openrouter.ai/keys → create → paste below.
#   AI_MODEL must support `response_format` (the enrich/estimate endpoints ask for JSON) and must
#   still exist — OpenRouter retires free slugs regularly. Check before setting one:
#     curl -s https://openrouter.ai/api/v1/models/<model>/endpoints | head -c 400
#   Verify the id and that supported_parameters lists response_format.
#   Default: nvidia/nemotron-3-super-120b-a12b:free (free, JSON-capable).
# Other options:
#   Google AI Studio https://aistudio.google.com — AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai , AI_MODEL=gemini-2.5-flash
#   Groq https://console.groq.com — blocked for Iranian IPs at the time of writing
# Leave AI_API_KEY empty to disable the /ai endpoints (they answer 503 AI_NOT_CONFIGURED).
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
AI_TIMEOUT_MS=60000

# Resilience. The server retries a rate-limited/5xx model (backoff, honouring the provider's
# Retry-After / x-ratelimit-reset) and then walks the list below before giving up. A timeout is
# NOT retried — making the user wait twice is worse than failing fast.
AI_RETRY_ATTEMPTS=2
AI_RETRY_BASE_MS=800
# Extra models on the SAME provider, comma-separated, tried in order. Cheap insurance against two
# different failures: one model being saturated (429/5xx) and one slug having been retired (404).
# This is what kills the "AI unavailable" loop in practice: a busy `:free` slug answers 429 for
# minutes while its neighbours are idle, and the chain moves on to the next one.
# NOTE: OpenRouter's free-model cap is account-wide — 20 req/min and 50 req/day total for accounts
# with under 10 credits of lifetime purchases (1000/day at 10+). Another `:free` slug does NOT reset
# that daily counter, so a second provider is what saves a capped day.
AI_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-super-120b-a12b:free,dots-studio/dots-3-note-preview:free,apodex/apodex-1.1-mini:free,liquid/lfm-2.5-2.6b:free

# Optional second provider, tried last (leave the key empty to disable). Google AI Studio has a
# usable free tier and an OpenAI-compatible endpoint; its quota is separate from OpenRouter's.
#   AI_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_FALLBACK_MODEL=gemini-2.5-flash
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_MODEL=

# §AI semantic search (pgvector). Embeddings reuse AI_API_KEY/AI_BASE_URL unless the dedicated
# variables below are set. The database column is vector(1536), so use a 1536-dimension model;
# changing AI_EMBEDDING_MODEL to another size needs a migration (the endpoint rejects mismatches).
# If the provider has no embeddings access, /search still works lexically and reports
# `semantic.available: false` instead of failing.
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_BASE_URL=
