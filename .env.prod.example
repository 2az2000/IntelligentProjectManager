# Copy to .env (same file the dev compose uses) and fill in before `up`.
# Public origin Caddy serves — also used for CORS/CSRF allowlist and TLS cert.
PUBLIC_URL=https://pm.example.com
# or for a local smoke test: PUBLIC_URL=localhost

POSTGRES_USER=pm
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=projectmanagement

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

RATE_LIMIT_PER_MINUTE=300
# Backup cadence (seconds) and retention (14 dumps) — see db-backup service.
BACKUP_INTERVAL_SECONDS=86400
