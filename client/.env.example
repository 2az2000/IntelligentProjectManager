# Absolute API origin in dev. In production behind the reverse proxy use "/api"
# (same origin) and NEXT_PUBLIC_SOCKET_PATH=/api/socket.io — see docker-compose.prod.yml.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Socket.IO engine path (only needed when the API is mounted under a prefix).
# NEXT_PUBLIC_SOCKET_PATH=/socket.io
